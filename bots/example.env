# Local GGUF-backed Grok Bot
# Copy to .env and fill in. Do not commit secrets.

# microagent / llama.cpp
MICROAGENT_LLAMA_SERVER=/usr/local/bin/llama-server
# MICROAGENT_MODEL_RUNNER_ARGS="-ngl all"

# OpenAI-compatible endpoint exposed by microagent model serve
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=local

# Default evaluation model
EVAL_MODEL=jev
EVAL_GGUF=jev/models/jev.gguf
EVAL_ENGINE=jev/engine/nrse.pl

# Optional: fall back to xAI when local is down
# XAI_API_KEY=xai-...
